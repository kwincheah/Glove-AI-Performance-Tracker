<Window x:Class="PerformanceTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VMControls.WPF.Release;assembly=VMControls.WPF.Release"
        mc:Ignorable="d"
        Title="Glove AI Tracker" Height="900" Width="1300"
        Background="#0A0A0B" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Resources/favicon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#141417" BorderBrush="#222226" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.4" ShadowDepth="2"/>
            </Border.Effect>
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#0D6EFD" CornerRadius="8" Margin="0,0,20,0">
                        <TextBlock Text="V" Foreground="White" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="25"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BITMAP VISION AI TRACKER" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="SYSTEM STATUS: OPERATIONAL" Foreground="#00C853" FontSize="10" FontWeight="SemiBold" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="GLOBAL INFERENCE PROGRESS" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ElementName=GlobalProgressBar, Path=Value, StringFormat={}{0:0}%}" 
                                   Foreground="#0D6EFD" FontSize="9" HorizontalAlignment="Right" FontWeight="Bold"/>
                    </Grid>
                    <ProgressBar x:Name="GlobalProgressBar" Height="8" Background="#222226" Foreground="#0D6EFD" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Summary_Click" Width="150" Height="42" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#1E1E24" CornerRadius="21" BorderBrush="#333333" BorderThickness="1">
                                    <TextBlock Text="Summary" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Click="Reset_Click" Width="100" Height="42" Margin="0,0,10,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#1E1E24" CornerRadius="21" BorderBrush="#333333" BorderThickness="1">
                                    <TextBlock Text="Reset" Foreground="#FF5252" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="StartAllButton" Click="StartAll_Click" Width="180" Height="42" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#0D6EFD" CornerRadius="21">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#0b5ed7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock x:Name="StartBtnText" Text="Start Inference" Foreground="White" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl x:Name="LinesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="15" Background="#141417" CornerRadius="15" BorderBrush="#2A2A30" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" Opacity="0.3" ShadowDepth="5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="360"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="20,15">
                                    <TextBlock Text="{Binding LineName}" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                                    <Border HorizontalAlignment="Right" Background="#1E1E24" Padding="10,4" CornerRadius="6">
                                        <TextBlock Text="{Binding Mode}" Foreground="#888888" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Background="Black" Margin="15,0" CornerRadius="8" ClipToBounds="True">
                                    <vm:VmRenderControl ModuleSource="{Binding AiModule}">
                                        <vm:VmRenderControl.Style>
                                            <Style TargetType="vm:VmRenderControl">
                                                <EventSetter Event="Loaded" Handler="VmRenderControl_Loaded"/>
                                            </Style>
                                        </vm:VmRenderControl.Style>
                                    </vm:VmRenderControl>

                                </Border>

                                <Border Grid.Row="2" Padding="20,15" Background="#1A1A1E" CornerRadius="0,0,15,15">
                                    <StackPanel>
                                        <ProgressBar Value="{Binding CurrentProgress}" Maximum="{Binding TotalImages}" Height="4" Foreground="#0D6EFD" Background="#121215" BorderThickness="0" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Foreground="#BBBBBB" FontSize="12">
                                                <Run Text="{Binding Status}"/> <Run Text=" ("/><Run Text="{Binding CurrentProgress}"/><Run Text="/"/><Run Text="{Binding TotalImages}"/><Run Text=")"/>
                                            </TextBlock>
                                            <TextBlock Text="LATENCY: 12ms" Foreground="#555555" FontSize="10" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Border Background="#121215" Padding="15,12" CornerRadius="10" BorderBrush="#2A2A30" BorderThickness="1" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="OK" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding OK}" Foreground="#00C853" FontSize="26" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="OK-NG" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding OKNG}" Foreground="Red" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="OK%" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding OKPcnt, StringFormat={}{0:P2}}" Foreground="#0D6EFD" FontSize="26" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Visibility="{Binding IsPostMode, Converter={StaticResource BoolToVis}}" Background="#121215" Padding="15,12" CornerRadius="10" BorderBrush="#2A2A30" BorderThickness="1" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Tear" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Tear}" Foreground="#00C853" FontSize="26" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Tear-OK" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding TearOK}" Foreground="Red" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="Tear %" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding TearPcnt, StringFormat={}{0:P2}}" Foreground="#0D6EFD" FontSize="26" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="#121215" Padding="15,12" CornerRadius="10" BorderBrush="#2A2A30" BorderThickness="1" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Stain" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Stain}" Foreground="#00C853" FontSize="26" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Stain-OK" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding StainOK}" Foreground="Red" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="Stain %" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding StainPcnt, StringFormat={}{0:P2}}" Foreground="#0D6EFD" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Background="#121215" Padding="15,12" CornerRadius="10" BorderBrush="#2A2A30" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="FP-OK" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding FPOK}" Foreground="#00C853" FontSize="26" FontWeight="Bold"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="20,0">
                                                    <TextBlock Text="FP" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FP}" Foreground="Red" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="FP-OK %" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FPPcnt, StringFormat={}{0:P2}}" 
                       Foreground="#0D6EFD" FontSize="26" FontWeight="Bold" 
                       HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid x:Name="WelcomeOverlay" 

              Grid.Row="0" 
              Grid.RowSpan="2" 

              Panel.ZIndex="100" 

              Background="#F20A0A0B" 

              Visibility="Visible">
            <Border Width="500" Height="400" Background="#141417" CornerRadius="25" BorderBrush="#333337" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" Opacity="0.6" ShadowDepth="0" Color="Black"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" Background="#0D6EFD" CornerRadius="20" Margin="0,0,0,30">
                        <TextBlock Text="V" Foreground="White" FontWeight="Black" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="45"/>
                    </Border>
                    <TextBlock Text="WELCOME GLOVE AI TRACKER" Foreground="White" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Vision AI Performance Tracker v2.0.1" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Button Click="Load_Click" Width="220" Height="50" Cursor="Hand" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="#0D6EFD" CornerRadius="25">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#0b5ed7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Configure Test" Foreground="White" FontWeight="Bold" FontSize="16"/>
                    </Button>
                    <TextBlock Text="Ensure Vision Master Server is active before loading." Foreground="#555555" FontSize="10" HorizontalAlignment="Center" Margin="0,20,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

        <Grid x:Name="SummaryOverlay" Grid.RowSpan="2" Panel.ZIndex="101" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="#08080A" Opacity="0.96"/>
            </Grid.Background>
            <Border Width="1000" Height="700" Background="#111114" CornerRadius="24" BorderBrush="#1F1F23" BorderThickness="1.5">
                <Grid Margin="40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>



                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <TextBlock Text="PRODUCTION LINE SUMMARY" Foreground="White" FontSize="24" FontWeight="Black" FontStretch="Expanded"/>
                        <Rectangle Height="4" Width="60" Fill="#0D6EFD" HorizontalAlignment="Left" Margin="2,8,0,0" RadiusX="2" RadiusY="2"/>
                    </StackPanel>



                    <Grid Grid.Row="1" Margin="20,0,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="LINE IDENTIFIER" Foreground="#4A4A52" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="METRIC CATEGORY" Foreground="#4A4A52" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="YIELD" Foreground="#4A4A52" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="READING" Foreground="#4A4A52" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="SYSTEM STATUS" Foreground="#4A4A52" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SummaryItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16161B" Margin="0,0,0,10" CornerRadius="12" BorderBrush="#1F1F23" BorderThickness="1" Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LineName}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#71717A" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Background="#102518" Padding="12,4" CornerRadius="15" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Percentage}" Foreground="#00E676" FontSize="13" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Reading}" Foreground="#3B82F6" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <Border Grid.Column="4" Background="#1A1A1E" Padding="10,5" CornerRadius="8" BorderBrush="#2A2A30" BorderThickness="1" HorizontalAlignment="Right">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <TextBlock Text="{Binding Status}" Foreground="#A1A1AA" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                        
                        <Button Click="SaveMisprediction_Click" Width="200" Height="48" Margin="0,30,20,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#3B82F6" CornerRadius="12" BorderBrush="#3F3F46" BorderThickness="1" >
                                        <TextBlock Text="Save Mispredicted Images" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="CloseSummary_Click" Width="180" Height="48" Margin="0,30,0,0" HorizontalAlignment="Right" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#1A1A1E" CornerRadius="12" BorderBrush="#3F3F46" BorderThickness="1">
                                        <TextBlock Text="Close Summary" Foreground="#A1A1AA" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>